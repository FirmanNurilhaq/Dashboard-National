# ==========================================
# 1. MICROSOFT SQL SERVER CONFIGURATION
# (Diisi sesuai kredensial Server Database saat server aktif)
# ==========================================
MSSQL_HOST=192.168.1.100
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrongPasswordHere!
MSSQL_DATABASE=TelecomProductivityDB
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_POOL_MAX=20
MSSQL_POOL_MIN=2

# ==========================================
# 2. GOOGLE SHEETS API CONFIGURATION
# ==========================================
GSHEET_SPREADSHEET_ID=your_spreadsheet_id_here
GSHEET_SHEET_NAME=National
GSHEET_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GSHEET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GSHEET_CHUNK_SIZE=50000

# ==========================================
# 3. EXCEL INITIAL SEED CONFIGURATION
# ==========================================
EXCEL_SEED_FILE_PATH=./Book1.xlsx
EXCEL_SEED_SHEET_NAME=Sheet1

# ==========================================
# 4. APP & RUNTIME CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_telecom_productivity_2026
CRON_SCHEDULE=0 * * * *
USE_LOCAL_DATA_CACHE=true
